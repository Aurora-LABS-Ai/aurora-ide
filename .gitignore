# Logs
logs
*.log
/logs.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build outputs
dist
dist-ssr
build
target
*.local
void-main

# Tauri build artifacts
src-tauri/target/
src-tauri/crispasr-runtime/
# Tauri generated files (keep schemas, ignore other generated files)
src-tauri/gen/
!src-tauri/gen/schemas/

# Vendored native runtime DLLs (ONNX Runtime / DirectML).
# Each developer populates these locally; see src-tauri/runtime/onnxruntime/.
src-tauri/runtime/onnxruntime/*.dll
src-tauri/runtime/onnxruntime/*.lib
src-tauri/runtime/onnxruntime/*.pdb

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# App data directories
.aurora/
*.aurora

# Local reference dumps / one-off analysis (not app source)
fireworks-docs
local-llm-docs/
docs-lm-studio
ollama-rs.md
raw-output.md
PROJECT_ANALYSIS.md
/deepseek-harness.txt
/global-AGENTS.md
/tsco.json
example.txt

# Local code-graph DBs (per-machine, not source)
.codegraph/

# Internal plan / architecture dumps. Public docs are GETTING-STARTED + theme-dev.
/DOCS/*.md
!/DOCS/finding.md
!/DOCS/GETTING-STARTED.md
!/DOCS/theme-dev.md
/DOCS/visual-studies/

# Local agent working memory (lessons / scratch progress). Not source.
.knowledge/

# Machine-specific MCP configs (absolute local paths). Never source.
.mcp.json

# Local smoke harnesses / pasted snippets
/scratch/
/tasks/

# Extracted agent session transcripts. Raw local chat logs, not source, and
# they quote real provider keys and machine paths.
/temp/

# Cloned third-party repos kept locally for reference/comparison (other
# agent harnesses, SDKs). Read-only study material — never our source, and
# vendoring someone else's git history into ours is not the intent.
/thirdparty/

# AI/ML tool directories — agent state, skill packs, IDE extensions,
# never part of source. These are all per-developer; checking them in
# means our git history catches every keystroke another tool makes.
.claude/
.claw/
.codex/
.cursor/
.zed/
.agents/
.refact/
.gitnexus/

# Agentic / IDE assistant instruction files that live at the repo
# root. They're personal config for whoever's machine the IDE is on
# — not project source.
AGENTS.md
CLAUDE.md
GEMINI.md
CODEX.md

# Junk dirs created by misconfigured tools writing to `undefined/...`
# (literal "undefined" string from `path.join(process.env.MISSING, ...)`).
# We've shipped at least one HuggingFace cache into here by accident.
/undefined/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local

# OpenClaude local provider credentials / machine overrides
.openclaude/settings.local.json
.openclaude-profile.json

# Python bytecode from local scratch scripts
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*.temp
nul

# Loose screenshots dropped at the repo root while debugging — not source.
/image.png
/image-*.png
/screenshot.png
/screenshot-*.png

# HAR captures — contain live session cookies and account data
*.har
